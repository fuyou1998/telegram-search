# Telegram user API: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional SOCKS5 or HTTP proxy used for Telegram login and searches.
TELEGRAM_PROXY_URL=

# Comma-separated search bots, up to 5. Leave empty to use official search only.
TELEGRAM_SEARCH_BOTS=@jisou

# Search behaviour. All of these can also be changed from the web settings dialog.
TELEGRAM_OFFICIAL_SEARCH=1
TELEGRAM_BOT_VARIANTS=4
TELEGRAM_MAX_VARIANTS=14
TELEGRAM_ENRICH=1

# Optional. AI keyword expansion receives your search query.
# channel_card.py sends public post samples only when explicitly run with --ai.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_PROXY_URL=
# Optional. Only set for providers that accept it; "low" keeps one-shot requests fast.
AI_REASONING_EFFORT=

# Languages to translate keywords into. Comma separated, Chinese names are fine too.
AI_LANGUAGES=Russian, Persian, Arabic, Indonesian, Turkish, Portuguese, Spanish, Hindi, Urdu, Bengali, Vietnamese, Ukrainian, Uzbek, French, German, Italian, Filipino, Burmese, Korean, Japanese
AI_LANGUAGE_COUNT=5

# Branding and a promo link shown on the page when you distribute this.
APP_BRAND=极目
PROMO_TITLE=加入极目交流群
PROMO_TEXT=找群、反馈问题、看别人找到的好群。
PROMO_URL=https://t.me/jimu_group
PROMO_CHANNEL=https://t.me/jimu_feed
