* text=auto

# Keep shell launchers runnable on macOS/Linux.
*.sh text eol=lf
*.command text eol=lf

# Windows entry points and PowerShell scripts.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and web assets.
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.md text eol=lf
